@page "/reset-password"
@model SmartShoppingChatBot.API.Pages.ResetPasswordModel
@{
    Layout = null;

    var errors = Model.Errors;
    errors.TryGetValue("token", out var tokenError);
    errors.TryGetValue("newPassword", out var newPasswordError);
    errors.TryGetValue("confirmPassword", out var confirmPasswordError);

    var isTokenMissing = string.IsNullOrWhiteSpace(Model.Command.Token);
    var showSuccess = Model.HasSubmitted && Model.IsSuccess;
    var alertClass = showSuccess ? "message success" : isTokenMissing ? "message warning" : "message error";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Reset Password</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/css/verify-account.css" />
    <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body>
    <main class="page">
        <section class="shell" aria-label="Reset password form">
            <h1 class="title">Reset Password</h1>

            <div class="card">
                @if (!string.IsNullOrWhiteSpace(Model.Email))
                {
                    <p class="email-box">
                        Email: <strong>@Model.Email</strong>
                    </p>
                }

                @if (showSuccess)
                {
                    <div class="success-box">
                        <div class="success-icon" aria-hidden="true">
                            <i data-lucide="check"></i>
                        </div>
                        <h2 class="success-title">Password reset</h2>
                        <p class="success-message">You can now sign in with your new password.</p>

                        @if (!string.IsNullOrWhiteSpace(Model.Message))
                        {
                            <p class="@alertClass" aria-live="polite">@Model.Message</p>
                        }
                    </div>
                }
                else
                {
                    <form id="reset-password-form" method="post" novalidate>
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="Command.Token" value="@Model.Command.Token" />
                        <input type="hidden" name="Email" value="@Model.Email" />

                        @if (!string.IsNullOrWhiteSpace(Model.Message) || !string.IsNullOrWhiteSpace(tokenError))
                        {
                            <p class="@alertClass" role="alert">
                                @(tokenError ?? Model.Message)
                            </p>
                        }

                        <div class="field">
                            <label for="newPassword">New Password</label>
                            <div class="control">
                                <i data-lucide="lock"></i>
                                <input id="newPassword"
                                       name="Command.NewPassword"
                                       type="password"
                                       placeholder="Create a new password"
                                       autocomplete="new-password"
                                       minlength="6"
                                       required
                                       disabled="@isTokenMissing" />
                                <button class="toggle-pass"
                                        type="button"
                                        data-target="newPassword"
                                        aria-label="Show password"
                                        title="Show password"
                                        disabled="@isTokenMissing">
                                    <i data-lucide="eye"></i>
                                </button>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(newPasswordError))
                            {
                                <p class="error-text">@newPasswordError</p>
                            }
                        </div>

                        <div class="field">
                            <label for="confirmPassword">Confirm Password</label>
                            <div class="control">
                                <i data-lucide="lock"></i>
                                <input id="confirmPassword"
                                       name="Command.ConfirmPassword"
                                       type="password"
                                       placeholder="Confirm your new password"
                                       autocomplete="new-password"
                                       minlength="6"
                                       required
                                       disabled="@isTokenMissing" />
                                <button class="toggle-pass"
                                        type="button"
                                        data-target="confirmPassword"
                                        aria-label="Show confirm password"
                                        title="Show password"
                                        disabled="@isTokenMissing">
                                    <i data-lucide="eye"></i>
                                </button>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(confirmPasswordError))
                            {
                                <p class="error-text">@confirmPasswordError</p>
                            }
                        </div>

                        <button class="submit" type="submit" disabled="@isTokenMissing">
                            Reset Password
                        </button>
                    </form>
                }
            </div>
        </section>
    </main>

    <script>
        const newPasswordInput = document.getElementById("newPassword");
        const confirmPasswordInput = document.getElementById("confirmPassword");

        function refreshIcons() {
            if (window.lucide) {
                window.lucide.createIcons();
            }
        }

        refreshIcons();

        document.querySelectorAll(".toggle-pass").forEach(function (button) {
            button.addEventListener("click", function () {
                const input = document.getElementById(button.dataset.target);
                if (!input) {
                    return;
                }

                const isHidden = input.type === "password";
                input.type = isHidden ? "text" : "password";
                button.setAttribute("aria-label", isHidden ? "Hide password" : "Show password");
                button.setAttribute("title", isHidden ? "Hide password" : "Show password");
                button.innerHTML = isHidden ? '<i data-lucide="eye-off"></i>' : '<i data-lucide="eye"></i>';
                refreshIcons();
            });
        });

        function syncConfirmPasswordValidity() {
            if (!newPasswordInput || !confirmPasswordInput) {
                return;
            }

            const mismatched = confirmPasswordInput.value.length > 0
                && newPasswordInput.value !== confirmPasswordInput.value;

            confirmPasswordInput.setCustomValidity(mismatched ? "Passwords do not match." : "");
        }

        newPasswordInput?.addEventListener("input", syncConfirmPasswordValidity);
        confirmPasswordInput?.addEventListener("input", syncConfirmPasswordValidity);
    </script>
</body>
</html>
