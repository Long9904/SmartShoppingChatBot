@using SmartShoppingChatBot.Application.DTOs
@model RejectBusinessOwnerEmailModel


<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Kết quả xét duyệt doanh nghiệp</title>
</head>

<body style="margin:0;padding:0;background:#f6f7f9;font-family:Arial,Helvetica,sans-serif;color:#202124;">
    <div style="display:none;max-height:0;overflow:hidden;opacity:0;color:transparent;">
        Doanh nghiệp @Model.BusinessName chưa được phê duyệt. Vui lòng kiểm tra lại thông tin đăng ký.
    </div>

    <table width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation" style="background:#f6f7f9;">
        <tr>
            <td align="center" style="padding:32px 16px;">
                <table width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation" style="width:100%;max-width:560px;background:#ffffff;border:1px solid #e5e7eb;border-radius:14px;">
                    <tr>
                        <td style="padding:28px 32px 20px 32px;">
                            <div style="font-family:Arial,Helvetica,sans-serif;font-size:24px;font-weight:700;line-height:1;letter-spacing:0;color:#111827;">
                                Lunar AI
                            </div>
                        </td>
                    </tr>

                    <tr>
                        <td style="padding:0 32px;">
                            <div style="display:inline-block;padding:6px 10px;border-radius:999px;background:#fef2f2;color:#b42318;font-size:12px;font-weight:700;letter-spacing:.4px;text-transform:uppercase;">
                                Business not approved
                            </div>

                            <h1 style="margin:18px 0 12px 0;font-size:28px;line-height:1.25;font-weight:700;color:#111827;">
                                Doanh nghiệp chưa được phê duyệt
                            </h1>

                            <p style="margin:0;font-size:16px;line-height:1.6;color:#4b5563;">
                                Xin chào <strong style="color:#111827;">@Model.OwnerName</strong>, sau khi xem xét,
                                hồ sơ của <strong style="color:#111827;">@Model.BusinessName</strong>
                                hiện chưa đáp ứng điều kiện để kích hoạt tài khoản doanh nghiệp Lunar AI.
                            </p>
                        </td>
                    </tr>

                    <tr>
                        <td style="padding:24px 32px 0 32px;">
                            <table width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation" style="background:#fffbeb;border:1px solid #fedf89;border-radius:10px;">
                                <tr>
                                    <td style="padding:14px 16px;font-size:14px;line-height:1.6;color:#7a2e0e;">
                                        Vui lòng kiểm tra lại thông tin doanh nghiệp, giấy tờ xác minh hoặc dữ liệu liên hệ trước khi gửi lại yêu cầu.
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>

                    <tr>
                        <td style="padding:22px 32px 0 32px;">
                            <p style="margin:0;font-size:14px;line-height:1.6;color:#6b7280;">
                                Email đăng ký: <strong style="color:#374151;">@Model.OwnerEmail</strong>
                            </p>
                        </td>
                    </tr>

                    <tr>
                        <td style="padding:18px 32px 28px 32px;">
                            <p style="margin:0;font-size:14px;line-height:1.6;color:#6b7280;">
                                Nếu bạn cho rằng đây là nhầm lẫn, hãy phản hồi email này hoặc liên hệ bộ phận hỗ trợ để được kiểm tra lại.
                            </p>
                        </td>
                    </tr>
                </table>

                <table width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation" style="width:100%;max-width:560px;">
                    <tr>
                        <td style="padding:18px 8px 0 8px;text-align:center;font-size:12px;line-height:1.6;color:#9ca3af;">
                            Lunar AI · AI Ecommerce SaaS
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>
</html>
